# @import(../../apps/web/, pick=[NODE_ENV, DATABASE_URL])
# @defaultRequired=false
# @defaultSensitive=true
# ---
# Cloud stages generate these resources; the dev stack still requires both through Effect Config.
# @required=false
DATABASE_URL=
# @required=false
BETTER_AUTH_SECRET=

ALCHEMY_PASSWORD=
NEON_API_KEY=

# Public write-only PostHog project token. Required for the production stage.
# @public @required=false
POSTHOG_PROJECT_TOKEN=

# Google OAuth client used by sign-in. Cloud stages read them from GitHub environment secrets.
# @required=false
GOOGLE_CLIENT_ID=
# @required=false
GOOGLE_CLIENT_SECRET=
# Verified Google e-mail that becomes the first administrator when none exists.
# @required=false
BOOTSTRAP_ADMIN_EMAIL=
