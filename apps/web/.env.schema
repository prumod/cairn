# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=1)
DATABASE_URL=

# Google OAuth client for sign-in (Google Cloud console, OAuth client for a web application).
GOOGLE_CLIENT_ID=

# @sensitive
GOOGLE_CLIENT_SECRET=

# Verified Google e-mail that becomes the first administrator when none exists.
BOOTSTRAP_ADMIN_EMAIL=

# Signs Better Auth cookies and tokens. At least 32 characters.
# @required=false @sensitive
BETTER_AUTH_SECRET=
